# ---------------------------------------------------------------------------
# Provider selection
# Leave all three on "mock" to run the agent offline with zero credentials.
# ---------------------------------------------------------------------------
STT_PROVIDER=mock         # mock | sarvam
LLM_PROVIDER=mock         # mock | openai | gemini
TTS_PROVIDER=mock         # mock | sarvam

# --- Sarvam AI (speech in and out) ----------------------------------------
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai
SARVAM_STT_MODEL=saaras:v2.5
SARVAM_TTS_MODEL=bulbul:v2
SARVAM_SPEAKER=anushka
TTS_PACE=1.0
TTS_SAMPLE_RATE=22050

# --- LLM -------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
TEMPERATURE=0.7
MAX_TOKENS=300

# --- Behaviour -------------------------------------------------------------
DEFAULT_LANGUAGE=mixed    # mixed | te-IN | en-IN
MAX_HISTORY_TURNS=20
REQUEST_TIMEOUT=60
MAX_RETRIES=3
ENABLE_TTS=true
OUTPUT_DIR=output
